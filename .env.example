# Supabase Transaction pooler (puerto 6543). Copia la URL exacta desde Connect.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST_POOLER:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Session pooler (puerto 5432), usado por Prisma Migrate.
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST_POOLER:5432/postgres"

# Genera un valor aleatorio de al menos 32 bytes. No reutilices este ejemplo.
AUTH_SECRET="reemplaza-por-un-secreto-largo-y-aleatorio"

